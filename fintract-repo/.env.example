# FinTract environment configuration (copy to backend/.env for local dev)

# Database — defaults to a local SQLite file if unset.
# For PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./fintract.db

# JWT signing — MUST be a long random string in production.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Redis (used for distributed rate-limiting/caching).
REDIS_URL=

# Rate limiting (per client IP).
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# CORS — comma-separated origins, or * for any.
CORS_ORIGINS=*

    # ── Email / SMTP (required for email verification) ──────────────────────────
    # Leave blank to disable emails in development (a dev verify URL prints to API response).
    # Gmail: use an App Password (myaccount.google.com/apppasswords), NOT your real password.
    SMTP_HOST=smtp.gmail.com
    SMTP_PORT=587
    SMTP_USER=your-email@gmail.com
    SMTP_PASSWORD=your-app-password
    SMTP_FROM_ADDRESS=noreply@fintract.app
    APP_BASE_URL=http://localhost:8000

    # ── Stripe (optional — enables premium subscriptions) ────────────────────────
    # Get keys from https://dashboard.stripe.com/apikeys
    STRIPE_SECRET_KEY=sk_test_...
    STRIPE_PUBLISHABLE_KEY=pk_test_...
    STRIPE_WEBHOOK_SECRET=whsec_...
    STRIPE_PRO_PRICE_ID=price_...
    